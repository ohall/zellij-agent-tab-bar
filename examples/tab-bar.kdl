// Replace __ABSOLUTE_PLUGIN_PATH__ with the path printed by scripts/install.sh.
// Merge this alias into the plugins block of your Zellij config.kdl.
plugins {
    tab-bar location="file:__ABSOLUTE_PLUGIN_PATH__" {
        badge_idle "💤"
        badge_running "🚀"
        badge_complete "✅"
        badge_error "❌"

        layout_separator "   "
        layout_max_tab_width 32
        layout_show_index true

        behavior_auto_name true
        theme_color true
        debug false
    }
}
